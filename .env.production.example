APP_NAME="منصة مساري - الرابطة الجهوية لكرة القدم بالبليدة"
APP_ENV=production
APP_KEY=base64:WZ27toyuwfOaKsKjg2zqggddAu40faLBjdyPKW2O87E=
APP_DEBUG=false
APP_TIMEZONE=Africa/Algiers
# رابط المنصة على الاستضافة (مثال: https://masari.lrf-blida.dz أو https://lrf-blida.dz/masari)
APP_URL=https://masari.lrf-blida.dz

APP_LOCALE=ar
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=ar_SA

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# معلومات قاعدة البيانات في الاستضافة (يتم إنشاؤها من لوحة التحكم cPanel -> MySQL Databases)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=اسم_قاعدة_البيانات_في_الاستضافة
DB_USERNAME=اسم_مستخدم_قاعدة_البيانات
DB_PASSWORD=كلمة_مرور_قاعدة_البيانات

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
